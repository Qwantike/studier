# Connexion PostgreSQL locale
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/etudes
# Port de l'API
PORT=3001
# Synchronisation automatique des calendriers par URL, en minutes (0 pour désactiver)
CALENDAR_SYNC_MINUTES=60
# development | production (en production les cookies de session sont « Secure » : HTTPS obligatoire)
NODE_ENV=development
# Clé de signature des sessions, 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Création de comptes ouverte à tous (true/false). Laisser à false tant que les protections SSRF des calendriers ne sont pas en place.
ALLOW_SIGNUP=false
# Tests en local uniquement : autorise les abonnements vers localhost / réseau privé et tous les ports (SSRF !)
CALENDAR_ALLOW_PRIVATE_URLS=false
# Origines autorisées du client (séparées par des virgules) : CORS + protection CSRF
APP_ORIGINS=http://localhost:5173
# Nombre de proxys devant l'API (0 en local, 1 derrière nginx/Vercel)
TRUST_PROXY=0
